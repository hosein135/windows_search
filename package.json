{
  "name": "windows-search",
  "version": "0.1.0",
  "private": true,
  "description": "Demo Windows GUI search app: Bun CLI + Electron GUI, MongoDB storage, GPU-accelerated ranking via WebGPU across every GPU process (CPU worker-pool fallback), all-core chunked parallel import",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "start:gpu-unsafe": "electron . --gpu-unsafe",
    "start:no-helpers": "electron . --no-gpu-helpers",
    "import": "bun scripts/import-cli.js",
    "import:parallel": "bun scripts/import-cli.js --parallel",
    "make-sample": "bun scripts/make-sample-data.js",
    "smoke": "bun scripts/smoke-test.js",
    "hardware": "bun scripts/hardware-cli.js"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  }
}
